rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staffProfilePath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function hasActiveStaffProfile() {
      return request.auth != null &&
        exists(staffProfilePath(request.auth.uid)) &&
        get(staffProfilePath(request.auth.uid)).data.activo == true &&
        get(staffProfilePath(request.auth.uid)).data.rol in ['admin', 'seller'];
    }

    function hasStaffRole() {
      return request.auth != null &&
        (exists(staffProfilePath(request.auth.uid))
          ? hasActiveStaffProfile()
          : request.auth.token.role in ['admin', 'seller']);
    }

    function isAdmin() {
      return request.auth != null &&
        (exists(staffProfilePath(request.auth.uid))
          ? hasActiveStaffProfile() &&
            get(staffProfilePath(request.auth.uid)).data.rol == 'admin'
          : request.auth.token.role == 'admin');
    }

    // Firestore evalúa como máximo 1000 expresiones por petición. Cada línea
    // se valida con una sola expresión regular sobre sus tres campos unidos
    // (falla si falta alguno o no es texto) para admitir pedidos de varias líneas.
    function validOrderItem(item) {
      return item.keys().hasOnly(['productoId', 'tamano', 'cantidad']) &&
        item.cantidad is int &&
        (item.productoId + '|' + item.tamano + '|' + string(item.cantidad))
          .matches('^[A-Za-z0-9_-]{1,100}[|][^|]{1,40}[|]([1-9]|[1-4][0-9]|50)$');
    }

    function validOrderItems(items) {
      return items is list &&
        items.size() >= 1 &&
        items.size() <= 15 &&
        (items.size() < 1 || validOrderItem(items[0])) &&
        (items.size() < 2 || validOrderItem(items[1])) &&
        (items.size() < 3 || validOrderItem(items[2])) &&
        (items.size() < 4 || validOrderItem(items[3])) &&
        (items.size() < 5 || validOrderItem(items[4])) &&
        (items.size() < 6 || validOrderItem(items[5])) &&
        (items.size() < 7 || validOrderItem(items[6])) &&
        (items.size() < 8 || validOrderItem(items[7])) &&
        (items.size() < 9 || validOrderItem(items[8])) &&
        (items.size() < 10 || validOrderItem(items[9])) &&
        (items.size() < 11 || validOrderItem(items[10])) &&
        (items.size() < 12 || validOrderItem(items[11])) &&
        (items.size() < 13 || validOrderItem(items[12])) &&
        (items.size() < 14 || validOrderItem(items[13])) &&
        (items.size() < 15 || validOrderItem(items[14]));
    }

    function validOrderRequest() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'cliente', 'items', 'metodoPago', 'notas', 'estado',
          'preciosVerificados', 'creadoEn'
        ]) &&
        data.keys().hasAll([
          'cliente', 'items', 'metodoPago', 'estado',
          'preciosVerificados', 'creadoEn'
        ]) &&
        data.cliente is map &&
        data.cliente.keys().hasOnly(['nombre', 'telefono']) &&
        data.cliente.keys().hasAll(['nombre', 'telefono']) &&
        data.cliente.nombre is string &&
        data.cliente.nombre.size() > 0 &&
        data.cliente.nombre.size() <= 120 &&
        data.cliente.telefono is string &&
        data.cliente.telefono.matches('^[+0-9(). -]{7,24}$') &&
        validOrderItems(data.items) &&
        data.metodoPago in ['Nequi', 'Transferencia', 'Efectivo'] &&
        (!('notas' in data) || (data.notas is string && data.notas.size() <= 1000)) &&
        data.estado == 'pendiente_revision' &&
        data.preciosVerificados == false &&
        data.creadoEn is timestamp &&
        data.creadoEn == request.time;
    }

    function validOrderStatus(status) {
      return status in [
        'pendiente_revision',
        'confirmado',
        'preparando',
        'en_camino',
        'entregado',
        'cerrado',
        'cancelado'
      ];
    }

    match /configuracion/{documentId} {
      allow read: if documentId == 'tienda';
      allow write: if documentId == 'tienda' && isAdmin();
    }

    match /categorias/{categoryId} {
      allow read: if resource.data.activa == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /productos/{productId} {
      allow read: if resource.data.activo == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /promociones/{promotionId} {
      allow read: if resource.data.activa == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pedidos/{orderId} {
      allow read: if hasStaffRole();
      allow create: if validOrderRequest();
      allow update: if hasStaffRole() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'estadoActualizadoEn'
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'estado', 'estadoActualizadoEn'
        ]) &&
        validOrderStatus(request.resource.data.estado) &&
        request.resource.data.estado != resource.data.estado &&
        (isAdmin() || !(resource.data.estado in ['entregado', 'cerrado'])) &&
        request.resource.data.estadoActualizadoEn == request.time;
      allow delete: if false;
    }

    match /usuarios/{userId} {
      allow read: if isAdmin() ||
        (request.auth != null && request.auth.uid == userId);
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'email', 'nombre', 'rol', 'activo', 'creadoEn', 'creadoPor', 'actualizadoEn'
        ]) &&
        request.resource.data.keys().hasAll([
          'email', 'nombre', 'rol', 'activo', 'creadoEn', 'creadoPor', 'actualizadoEn'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() <= 120 &&
        request.resource.data.rol in ['admin', 'seller'] &&
        request.resource.data.activo == true &&
        request.resource.data.creadoPor == request.auth.uid;
      allow update: if isAdmin() &&
        request.auth.uid != userId &&
        resource.data.rol in ['admin', 'seller'] &&
        request.resource.data.rol in ['admin', 'seller'] &&
        request.resource.data.keys().hasOnly([
          'email', 'nombre', 'rol', 'activo', 'creadoEn', 'creadoPor', 'actualizadoEn'
        ]) &&
        request.resource.data.keys().hasAll([
          'email', 'nombre', 'rol', 'activo', 'creadoEn', 'creadoPor', 'actualizadoEn'
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'rol', 'activo', 'actualizadoEn'
        ]) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() <= 120 &&
        request.resource.data.activo is bool;
      allow delete: if false;
    }
  }
}
